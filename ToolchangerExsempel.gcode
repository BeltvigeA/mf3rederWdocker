M83
M104 S165





SM_PRINT_START_LINE INDEX=3 TARGET_TEMP=225

M109 S225 T3
M106 S0

TIMELAPSE_START
G90
G21
M83 ; use relative distances for extrusion
; Change Tool3 -> Tool3 (layer -1)
G91
G0 Z1.5 F600
G90
G1 F21000
T3

M400

;_FORCE_RESUME_FAN_SPEED
