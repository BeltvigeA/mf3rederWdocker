PRINT_START
;===== 预热热床和第一个挤出头 =================
M140 S35
M104 T3 S140

;===== 粗回零 =================
G28 X Y
T3
M109 T3 S140
G28 Z
G90
G0 Z10 F10000
MOVE_TO_DISCARD_FILAMENT_POSITION
M109 S175
ROUGHLY_CLEAN_NOZZLE_WITH_DISCARD
M104 S135
G4 P2000
ROUGHLY_CLEAN_NOZZLE
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

;===== 检测钢板 =================
DETECT_BED_PLATE
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

;===== 自动进料  ======================
SM_PRINT_AUTO_FEED EXTRUDER=0
SM_PRINT_AUTO_FEED EXTRUDER=1
SM_PRINT_AUTO_FEED EXTRUDER=2
SM_PRINT_AUTO_FEED EXTRUDER=3

;===== 挤出流量  ======================

SM_PRINT_FLOW_CALIBRATE INDEX=0 TARGET_TEMP=220



SM_PRINT_FLOW_CALIBRATE INDEX=2 TARGET_TEMP=255


SM_PRINT_FLOW_CALIBRATE INDEX=3 TARGET_TEMP=225


;===== 取出第一个挤出头 =================
T3
SET_VELOCITY_LIMIT ACCEL=10000
M204 S10000

;===== 深度清洁喷嘴 =================
G90
G0 Z10 F10000
ROUGHLY_CLEAN_NOZZLE_WITH_DISCARD
G0 Z5 F10000
FINELY_CLEAN_NOZZLE_STAGE_1
G0 Z5 F10000
ROUGHLY_CLEAN_NOZZLE
G0 Z5 F10000
FINELY_CLEAN_NOZZLE_STAGE_2
M83

;===== 第一个挤出头降温 =================
M109 S135
M190 S35
M106 S0
G90
G0 Z5 F10000
MOVE_TO_DISCARD_FILAMENT_POSITION
INNER_CUTOFF_BASE_DISCARD
INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD
INNER_ROUGHLY_CLEAN_NOZZLE_BASE_DISCARD
MOVE_TO_XY_IDLE_POSITION_EXTRUDER

;===== 精回零 =================
G28 Z
;===== 热床调平 =================
; Always pass `ADAPTIVE_MARGIN=0` because Orca has already handled `adaptive_bed_mesh_margin` internally
; Make sure to set ADAPTIVE to 0 otherwise Klipper will use it's own adaptive bed mesh logic
BED_MESH_CALIBRATE mesh_min=89.368,112.72 mesh_max=206.91,260.41 ALGORITHM=bicubic PROBE_COUNT=4,4 ADAPTIVE=0 ADAPTIVE_MARGIN=0

;BED_MESH_CALIBRATE PROBE_COUNT=7,7


;======== 预挤出/划线 ================

SM_PRINT_START_LINE INDEX=0 TARGET_TEMP=220
M83
M104 S130





